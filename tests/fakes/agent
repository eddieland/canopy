#!/usr/bin/env python3
"""Fake agent runtime for tests. Stands in for `overseer_cmd` and `worker_cmd`.

Prints a few lines of chatter, then a final line, then exits. Configured through the environment:

    FAKE_AGENT_RESULT   the run's result. Default: a `done` worker result. A JSON object is reported as canopy's
                        agents report, by calling `<server>_result` with it as the last thing the run does, where the
                        run is told what it reports (CANOPY_RESULT), prints events, and its inline config names
                        `canopy_run` or `canopy_chore`; the server refuses one that is not the run's result. Anywhere
                        else, and for anything that is no JSON object, it is the final stdout line, verbatim, which
                        canopy reads as no agent's result: set it to "not json", or to the empty string for no final
                        line, for a run that reports nothing.
    FAKE_AGENT_SAYS     a line said before the commands run, so in a message of its own before the final line's.
                        Default none.
    FAKE_AGENT_EXIT     exit code. Default 0.
    FAKE_AGENT_SLEEP    seconds to sleep before printing the final line, to exercise timeouts. Default 0.
    FAKE_AGENT_COMMANDS a JSON list of argv lists, run in order before the final line, the way an agent runs
                        commands through its bash tool. Stands in for a worker's git, say. Default none.
    FAKE_AGENT_TOOLS    a JSON list of [tool, arguments] pairs, each called in order before the commands, `tool` named
                        as OpenCode names it, `<server>_<tool>`, through the local MCP server of that name its inline
                        config names (OPENCODE_CONFIG_CONTENT), as OpenCode starts it: its command, in its cwd, with
                        the agent's whole environment. Stands in for an overseer calling `canopy_decide`, or a chore
                        `canopy_chore_history`. Default none. A call no server named answers fails as OpenCode's would.
    FAKE_AGENT_THEN_TOOLS
                        the same, called after the commands, so after a held run's gate (tests/canopy/scenario_helpers):
                        stands in for a worker that calls `canopy_run_messages` once the operator sent it one.
    FAKE_AGENT_LOG      if set, a JSON object of "argv", "stdin", "cwd", "env", "tools", and "commands", on one line,
                        is appended to this file per run. `stdin` is what was piped to it, None from a terminal or
                        /dev/null, as `opencode run` takes a piped prompt. `env` holds the CANOPY_* and OPENCODE_*
                        variables the agent saw; `commands` holds each command's argv, exit code, stdout, and stderr;
                        `tools` each tool call's name, arguments, text, and whether it was an error.
    FAKE_AGENT_SESSION  with `--format json`, the `sessionID` on every event. Default `ses_fake`.
    FAKE_AGENT_STEP_COST
                        with `--format json`, each of the two `step_finish` events' `part.cost`, verbatim JSON, so a
                        test can make it invalid. Default 0.125. Each step's tokens are STEP_TOKENS.
    FAKE_AGENT_ERRORS   with `--format json`, a JSON list, each the `error` of an `error` event printed after the final
                        line, as OpenCode prints one when the session fails. Default none.

With `--format json` it prints what `opencode run --format json` does: one JSON event per line, its text as `text`
events, each command it ran as a `bash` `tool_use` event once it ends, each tool it called as a `tool_use` event of its
name, with when the call started and ended, and two model calls as `step_finish` events, their replies `msg_1` and
`msg_2`.
Otherwise it prints its text as plain lines.

A run started with `--agent canopy-worker` reads FAKE_WORKER_RESULT, FAKE_WORKER_SAYS, FAKE_WORKER_EXIT,
FAKE_WORKER_SLEEP, FAKE_WORKER_COMMANDS, FAKE_WORKER_THEN_TOOLS, FAKE_WORKER_SESSION, FAKE_WORKER_STEP_COST, and
FAKE_WORKER_ERRORS first,
falling back to the FAKE_AGENT_* ones, so one test can script an overseer and the workers it dispatches.
`--agent canopy-overseer` reads FAKE_OVERSEER_* the same way, `--agent canopy-planner` FAKE_PLANNER_*, and
`--agent canopy-worker-private` FAKE_WORKER_PRIVATE_*.

A run whose argv carries `--title=<title>` is of the ticket the title names first, as canopy's session titles do
(`PROJ-1 implement: ...`). FAKE_<ROLE>_FOR, a JSON object from a ticket key to settings named without the prefix
(`{"PROJ-2": {"RESULT": "...", "EXIT": "1"}}`), scripts that ticket's runs: what it gives for the run's ticket is read
before the role's, so one tick's workers can each do something of their own.

Stdlib only, no canopy imports: this runs as a separate process under whatever python3 is on PATH.
"""

import functools
import itertools
import json
import os
import subprocess  # noqa: TID251  (stands in for an agent runtime, which runs commands and local MCP servers)
import sys
import time
from pathlib import Path
from typing import Any

DEFAULT_RESULT = {"status": "done", "summary": "fake agent: nothing to do"}
STEP_TOKENS = {"input": 1000, "output": 200, "reasoning": 30, "cache": {"read": 4000, "write": 500}}
# How long the agent waits for a local MCP server to answer.
SERVER_TIMEOUT = 60


def role(argv: list[str]) -> str:
    if "--agent" in argv[:-1]:
        agent = argv[argv.index("--agent") + 1]
        # A chore's own copy of the chore's agent, `canopy-chore-<name>`, plays the chore.
        if agent.startswith("canopy-chore-"):
            return "CHORE"
        return agent.removeprefix("canopy-").upper().replace("-", "_")
    return "AGENT"


def setting(argv: list[str], name: str, default: str) -> str:
    for_ticket = ticket_settings(argv).get(name)
    if for_ticket is not None:
        return for_ticket
    specific = os.environ.get(f"FAKE_{role(argv)}_{name}")
    return specific if specific is not None else os.environ.get(f"FAKE_AGENT_{name}", default)


def ticket_settings(argv: list[str]) -> dict[str, str]:
    """What FAKE_<ROLE>_FOR scripts for the ticket this run's `--title=` names first; nothing if either is missing."""
    scripts = os.environ.get(f"FAKE_{role(argv)}_FOR")
    titles = [arg.removeprefix("--title=") for arg in argv[:-1] if arg.startswith("--title=")]
    if not scripts or not titles or not titles[0].split():
        return {}
    settings: dict[str, str] = json.loads(scripts).get(titles[0].split()[0], {})
    return settings


def run_commands(argv: list[str]) -> list[dict[str, object]]:
    ran: list[dict[str, object]] = []
    for command in json.loads(setting(argv, "COMMANDS", "[]")):
        proc = subprocess.run(command, capture_output=True, text=True, check=False)  # noqa: S603  (argv from the test)
        ran.append({"argv": command, "returncode": proc.returncode, "stdout": proc.stdout, "stderr": proc.stderr})
        if events(argv):
            # OpenCode prints a call once it has ended, as completed whatever the command's exit.
            shell = " ".join(command)
            state = {"status": "completed", "input": {"command": shell}, "output": proc.stdout, "title": shell}
            emit(argv, "tool_use", {"type": "tool", "tool": "bash", "state": state})
    return ran


def calls_tools(argv: list[str]) -> bool:
    return bool(json.loads(setting(argv, "TOOLS", "[]")))


def inline_servers() -> dict[str, dict[str, Any]]:
    mcp: dict[str, Any] = json.loads(os.environ.get("OPENCODE_CONFIG_CONTENT") or "{}").get("mcp", {})
    # OpenCode 2's shape, `mcp.servers`, or 1's, the servers by name under `mcp`.
    return mcp["servers"] if isinstance(mcp.get("servers"), dict) else mcp


def result_tool(argv: list[str]) -> str | None:
    """The tool this run reports its result with, or None for a run that is told of none or prints no events."""
    if not os.environ.get("CANOPY_RESULT") or not events(argv):
        return None
    servers = inline_servers()
    return next((f"{server}_result" for server in ("canopy_run", "canopy_chore") if server in servers), None)


def call_tools(argv: list[str], name: str = "TOOLS", made: list[list[Any]] | None = None) -> list[dict[str, object]]:
    """Call each tool the script's `name` setting names, or each of `made`, through the server the inline config names.

    One session for each run of calls to the same server, as OpenCode keeps one open for the whole run.
    """
    calls: list[list[Any]] = made if made is not None else json.loads(setting(argv, name, "[]"))
    servers = inline_servers()

    def owner(call: list[Any]) -> str | None:
        # The longest server name the tool's name starts with, as `<server>_<tool>`.
        return max((s for s in servers if call[0].startswith(f"{s}_")), key=len, default=None)

    done: list[dict[str, object]] = []
    for server, run in itertools.groupby(calls, key=owner):
        group = list(run)
        if server is None:
            now = int(time.time() * 1000)
            answers = [(f"no MCP server serves {tool}", True, now, now) for tool, _ in group]
        else:
            answers = served(servers[server], [[tool.removeprefix(f"{server}_"), args] for tool, args in group])
        for (tool, arguments), (text, error, start, end) in zip(group, answers, strict=True):
            done.append({"name": tool, "arguments": arguments, "text": text, "error": error})
            if events(argv):
                outcome = {"status": "error", "error": text} if error else {"status": "completed", "output": text}
                state = {**outcome, "input": arguments, "time": {"start": start, "end": end}}
                emit(argv, "tool_use", {"type": "tool", "tool": tool, "state": state})
    return done


def served(entry: dict[str, Any], calls: list[list[Any]]) -> list[tuple[str, bool, int, int]]:
    """Open a session with the local server `entry` names, call each of `calls` in it, and close it.

    It gives back each call's text, whether it was a tool error, and when it started and ended, in milliseconds since
    the epoch, as OpenCode prints them. A server that does not answer fails every call left.
    """
    proc = subprocess.Popen(  # noqa: S603  (the command canopy's inline config names)
        entry["command"],
        cwd=entry.get("cwd"),
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    stdin, stdout = proc.stdin, proc.stdout
    assert stdin is not None
    assert stdout is not None
    answers: list[tuple[str, bool, int, int]] = []

    def ask(request_id: int, method: str, params: dict[str, Any]) -> dict[str, Any] | None:
        stdin.write(json.dumps({"jsonrpc": "2.0", "id": request_id, "method": method, "params": params}) + "\n")
        stdin.flush()
        line = stdout.readline()
        return json.loads(line) if line else None

    try:
        hello: dict[str, Any] = {
            "protocolVersion": "2025-06-18",
            "capabilities": {},
            "clientInfo": {"name": "fake", "version": "0"},
        }
        if ask(0, "initialize", hello) is not None:
            stdin.write(json.dumps({"jsonrpc": "2.0", "method": "notifications/initialized"}) + "\n")
            for n, (name, arguments) in enumerate(calls, 1):
                start = int(time.time() * 1000)
                answer = ask(n, "tools/call", {"name": name, "arguments": arguments})
                end = int(time.time() * 1000)
                if answer is None:
                    break
                if "result" not in answer:
                    answers.append((str(answer.get("error")), True, start, end))
                    continue
                result = answer["result"]
                text = "".join(c["text"] for c in result["content"])
                answers.append((text, bool(result["isError"]), start, end))
    finally:
        stdin.close()
        proc.wait(SERVER_TIMEOUT)
        stdout.close()
    left = len(calls) - len(answers)
    now = int(time.time() * 1000)
    return [*answers, *[("the MCP server did not answer", True, now, now)] * left]


def as_object(text: str) -> dict[str, Any] | None:
    try:
        found = json.loads(text)
    except ValueError:
        return None
    return found if isinstance(found, dict) else None


@functools.cache
def piped() -> str | None:
    """What was piped to it, read once: None from a terminal or when nothing was, as `opencode run` reads stdin."""
    if sys.stdin.isatty():
        return None
    return sys.stdin.read() or None


def events(argv: list[str]) -> bool:
    return "--format" in argv[:-1] and argv[argv.index("--format") + 1] == "json"


def emit(argv: list[str], kind: str, part: dict[str, object]) -> None:
    event = {"type": kind, "timestamp": int(time.time() * 1000), "sessionID": setting(argv, "SESSION", "ses_fake")}
    print(json.dumps({**event, "part": part}), flush=True)


def say(argv: list[str], text: str) -> None:
    if events(argv):
        emit(argv, "text", {"type": "text", "text": text})
    else:
        print(text, flush=True)


# The call's reply is message `msg_N`, the Nth model call, as the fake `opencode` exports the session's replies.
def step(argv: list[str], n: int) -> None:
    if events(argv):
        cost = json.loads(setting(argv, "STEP_COST", "0.125"))
        part = {"type": "step-finish", "messageID": f"msg_{n}", "reason": "stop", "cost": cost, "tokens": STEP_TOKENS}
        emit(argv, "step_finish", part)


def main(argv: list[str]) -> int:
    say(argv, "fake agent: starting")
    say(argv, f"fake agent: {len(argv)} argument(s)")
    says = setting(argv, "SAYS", "")
    if says:
        say(argv, says)
    step(argv, 1)
    tools = call_tools(argv)
    commands = run_commands(argv)
    tools += call_tools(argv, "THEN_TOOLS")

    log = os.environ.get("FAKE_AGENT_LOG")
    if log:
        env = {k: v for k, v in os.environ.items() if k.startswith(("CANOPY_", "OPENCODE_"))}
        with Path(log).open("a") as f:
            ran = {"argv": argv, "stdin": piped(), "cwd": str(Path.cwd()), "env": env, "tools": tools}
            ran["commands"] = commands
            f.write(json.dumps(ran) + "\n")

    time.sleep(float(setting(argv, "SLEEP", "0")))

    result = setting(argv, "RESULT", json.dumps(DEFAULT_RESULT))
    tool = result_tool(argv)
    reported = as_object(result) if tool else None
    if reported is not None:
        call_tools(argv, made=[[tool, reported]])
    elif result:
        say(argv, result)
    step(argv, 2)
    for error in json.loads(setting(argv, "ERRORS", "[]")) if events(argv) else []:
        session = setting(argv, "SESSION", "ses_fake")
        event = {"type": "error", "timestamp": int(time.time() * 1000), "sessionID": session}
        print(json.dumps({**event, "error": error}), flush=True)
    return int(setting(argv, "EXIT", "0"))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
