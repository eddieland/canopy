#!/usr/bin/env python3
"""Fake `opencode` for tests: plays OpenCode 2's `serve`, `api`, `session export`, and `run` from a state file, handing
`opencode run` to the fake agent beside it.

On PATH ahead of any real one, so no test reaches the operator's OpenCode or its sessions. Configured through the
environment:

    FAKE_OPENCODE_STATE     the state file, JSON, {"sessions": {ID: [[provider, model, cost], ...]}}. Missing, or no
                            entry for ID: OpenCode's `Session not found: ID` on stderr, and exit 1.
    FAKE_OPENCODE_LOG       if set, one JSON line {"argv": [...], "cwd": ..., "env": [...]} is appended per run, `env`
                            the names of the OPENCODE_* variables it was started with.

Keys of the state besides `sessions`, each optional:

    exit    the exit code of every serve, api, and export command, with `stderr`, for an OpenCode that fails.
            Default none.
    stderr  text printed on stderr with `exit`.
    config  the MCP servers of the config `config.get` answers with, as `{"mcp": {NAME: {...}}}` in OpenCode 1's
            shape or `{"mcp": {"servers": {NAME: {...}}}}` in 2's; 1's `"enabled": false` is 2's `"disabled": true`.
            Default none. The servers of an inline config in `OPENCODE_CONFIG_CONTENT`, as canopy gives a run its own,
            follow as a document of their own, as OpenCode merges it last.
    skills  the ids `skill.list` answers with. Default none.
    agents  each agent's permission rules by name, `[permission, pattern, action]` each, that `agent.list` answers
            with, beside every agent a definition in `OPENCODE_CONFIG_DIR` defines, after OpenCode 2's defaults, the
            permissions renamed as 2 reads 1's (`bash` is `shell`, `task` is `subagent`, `write` and `patch` are
            `edit`). Default none.
    models  the models `model.list` answers with, each a `provider/model`; any other line is passed over, as a
            line no list holds. Default none.
    variants  each model's variants by its line, which `model.list` lists with it. Default none.

`serve` says where it listens, then waits to be stopped; `api --server URL` answers `agent.list`, `skill.list`, and
`config.get` from the state, and `api --standalone model.list` the models. It writes what it prints as OpenCode does,
so a pipe gets at most what fits in its buffer. `run` runs `agent` with the same arguments, so a template that runs
`opencode run` plays the fake agent. Any other command exits 2.
Stdlib only, no canopy imports: this runs as a separate process under whatever python3 is on PATH.
"""

import contextlib
import json
import os
import sys
import time
from pathlib import Path
from typing import Any

# The rules OpenCode 2 starts every agent from, before its own.
DEFAULTS = [["*", "*", "allow"], ["read", "*.env", "ask"], ["read", "*.env.*", "ask"]]
# What OpenCode 2 reads each of OpenCode 1's permissions as.
RENAMED = {"bash": "shell", "task": "subagent", "write": "edit", "patch": "edit"}
# Where `serve` says it listens.
URL = "http://127.0.0.1:41234"


def main() -> int:
    log = os.environ.get("FAKE_OPENCODE_LOG")
    if log:
        with Path(log).open("a") as f:
            env = sorted(name for name in os.environ if name.startswith("OPENCODE_"))
            f.write(json.dumps({"argv": sys.argv[1:], "cwd": os.getcwd(), "env": env}) + "\n")
    match sys.argv[1:]:
        case ["session", "export", "--standalone", "--sanitize", session_id]:
            return export(session_id)
        case ["serve", "--hostname", "127.0.0.1", "--port", "0"]:
            return serve()
        case ["api", "--server", _, operation]:
            return api(operation)
        case ["api", "--standalone", "model.list"]:
            return api("model.list")
        case ["run", *_]:
            agent = Path(__file__).with_name("agent")
            os.execv(agent, [str(agent), *sys.argv[1:]])  # noqa: S606  (stands in for OpenCode running an agent)
            return 1  # not reached: `execv` returns only by raising
        case _:
            sys.stderr.write(
                f"fake opencode plays only `serve`, `api`, `session export`, and `run`, not {sys.argv[1:]}\n",
            )
            return 2


def serve() -> int:
    state = read_state()
    if "exit" in state:
        sys.stderr.write(str(state.get("stderr", "")))
        return int(state["exit"])
    print(f"opencode server listening on {URL}", flush=True)
    # Stopped by whoever started it, once its questions are answered.
    time.sleep(600)
    return 0


def api(operation: str) -> int:
    state = read_state()
    if "exit" in state:
        sys.stderr.write(str(state.get("stderr", "")))
        return int(state["exit"])
    match operation:
        case "agent.list":
            printed: Any = {
                "data": [
                    {
                        "id": name,
                        "permissions": [
                            {"action": RENAMED.get(p, p), "resource": t, "effect": a} for p, t, a in [*DEFAULTS, *rules]
                        ],
                    }
                    for name, rules in agents(state).items()
                ],
            }
        case "skill.list":
            printed = {"data": [{"id": name, "name": name, "description": "d"} for name in state.get("skills", [])]}
        case "config.get":
            printed = [{"type": "directory", "path": "/defs"}]
            for config in (state.get("config", {}), json.loads(os.environ.get("OPENCODE_CONFIG_CONTENT") or "{}")):
                if config.get("mcp"):
                    printed.append({"type": "document", "info": {"mcp": {"servers": servers(config["mcp"])}}})
        case "model.list":
            variants = state.get("variants", {})
            printed = {
                "data": [
                    {
                        "providerID": line.partition("/")[0],
                        "id": line.partition("/")[2],
                        "variants": [{"id": name} for name in variants.get(line, [])],
                    }
                    for line in state.get("models", [])
                    if "/" in line and " " not in line
                ],
            }
        case _:
            sys.stderr.write(f"fake opencode does not answer `api {operation}`\n")
            return 2
    write(json.dumps(printed, indent=2) + "\n")
    return 0


def agents(state: dict[str, Any]) -> dict[str, list[list[str]]]:
    """Each agent a definition in the config directory defines, as OpenCode loads them, with its rules in the state."""
    config_dir = os.environ.get("OPENCODE_CONFIG_DIR")
    defined = sorted(p.stem for p in Path(config_dir, "agents").glob("*.md")) if config_dir else []
    found: dict[str, list[list[str]]] = {name: [] for name in defined}
    return {**found, **state.get("agents", {})}


def servers(mcp: dict[str, Any]) -> dict[str, Any]:
    """The servers of `mcp`, either shape, in OpenCode 2's: `disabled` for 1's `enabled: false`."""
    named = mcp["servers"] if isinstance(mcp.get("servers"), dict) else mcp
    found = {}
    for name, server in named.items():
        entry = {k: v for k, v in server.items() if k != "enabled"}
        if server.get("enabled") is False:
            entry["disabled"] = True
        found[name] = entry
    return found


def export(session_id: str) -> int:
    state = read_state()
    if "exit" in state:
        sys.stderr.write(str(state.get("stderr", "")))
        return int(state["exit"])
    calls = state.get("sessions", {}).get(session_id)
    if calls is None:
        sys.stderr.write(f"Error: Session not found: {session_id}\n")
        return 1
    messages: list[dict[str, Any]] = [{"id": "msg_0", "type": "user", "text": "[redacted:text]", "files": []}]
    for i, (provider, model, cost) in enumerate(calls, start=1):
        ref = {"id": model, "providerID": provider}
        messages.append({"id": f"msg_{i}", "type": "assistant", "model": ref, "content": [], "cost": cost})
    write(json.dumps({"info": {"id": session_id}, "messages": messages}, indent=2) + "\n")
    return 0


def write(printed: str) -> None:
    """Print `printed` as OpenCode does with stderr a pipe: one write that does not wait for a full pipe to drain, and
    what did not fit lost when it exits. A file takes it all."""
    os.set_blocking(sys.stdout.fileno(), False)
    with contextlib.suppress(BlockingIOError):
        os.write(sys.stdout.fileno(), printed.encode())


def read_state() -> dict[str, Any]:
    path = os.environ.get("FAKE_OPENCODE_STATE")
    if not path or not Path(path).exists():
        return {}
    return json.loads(Path(path).read_text())


if __name__ == "__main__":
    sys.exit(main())
