#!/usr/bin/env python3
"""Fake canopy GitHub programs for tests: `canopy-connect-github` and `canopy-post-github` (DESIGN §29).

Run under either name (the two are links to this file); each speaks the real program's contract on stdin and stdout,
from a state file that stands in for GitHub. Configured through the environment:

    FAKE_GITHUB_STATE   the state file, JSON. Missing, GitHub holds every PR asked, open, with nothing on it.
    FAKE_GITHUB_LOG     if set, one JSON line {"program": "connect"|"post", "request": {...}} is appended per run.

State keys, each optional:

    prs         {URL: {"pr": {...}, "reviews": [...], "checks": [...]}}: each PR's `pr` line fields and its `review`
                and `check` lines, without `kind` and `pr`, which the reader adds. A `pr` line's fields default from
                the URL. With a state file, a PR not here is one the reader cannot read.
    unread      [URL or repository name]: PRs and repositories the reader cannot read whole, which it leaves off its
                `end` line.
    branches    {repository name: {branch: head sha}}: each repository's branches, printed when the request names
                the repository. A repository not here has none.
    review      [URL]: the review query's result, when the request has one. Default none.
    down        true: the reader prints nothing, not even its `end` line, and exits 1.
    hang        PATH: the reader creates PATH, then sleeps a minute before it reads, as a reader GitHub never answers.
    login       who the poster posts as. Default `me`.
    post        how the next post ends: `ok` (the default), `refused` (nothing posted, `"submitted": false`),
                `pending_left` (nothing posted, and its pending review left), or `unknown` (no `end` line). With
                `unknown`, `posted: true` makes it post all the same, as a submit that reached GitHub would.
    issues      [{"url": URL, "body": TEXT, "id": N}]: the comments the poster made on issues, appended as it posts.
    reactions   [{"pr": URL, "comment": ID, "reaction": NAME, "by": LOGIN}]: the reactions the poster added, appended
                as it adds them, once each, as GitHub keeps them.
    react       `refused`: GitHub refuses the first reaction, so the post adds none and opens no review.
    refuse_lines  ["PATH:LINE"]: lines GitHub's diff of the PR does not show, so a comment on one posts nothing of its
                review: the pending review is deleted, the error names the comment, and the post ends unsubmitted.

A post adds its reactions first, then, unless its replies are all reactions alone and it has no body or comments,
adds each reply's text to the state as a `comment` review line by the poster, on the thread of the comment it answers,
each of a review's `comments` as one on a thread of its own at its path and line, and the review as a `review` line,
with the `commit` it names, so the next read sees them. A post with `"submit": false` stages its review instead: the
review line is `pending`, as GitHub shows it to its author, until a test submits or deletes it in the state.

Stdlib only, no canopy imports: this runs as a separate process under whatever python3 is on PATH.
"""

import json
import os
import sys
import time
from pathlib import Path
from typing import Any


def main() -> int:
    program = Path(sys.argv[0]).name.removeprefix("canopy-").removesuffix("-github")
    if "--help" in sys.argv[1:]:
        print(f"usage: canopy-{program}-github")
        return 0
    request = json.loads(sys.stdin.read())
    log = os.environ.get("FAKE_GITHUB_LOG")
    if log:
        with Path(log).open("a") as f:
            f.write(json.dumps({"program": program, "request": request}) + "\n")
    path = Path(os.environ.get("FAKE_GITHUB_STATE", "/nonexistent"))
    nothing: dict[str, Any] = {}
    state = json.loads(path.read_text()) if path.is_file() else {"prs": dict.fromkeys(request.get("prs", []), nothing)}
    if program == "connect":
        return connect(state, request)
    code = post(state, request)
    if path.parent.is_dir():
        path.write_text(json.dumps(state))
    return code


def emit(line: dict[str, object]) -> None:
    print(json.dumps(line), flush=True)


def connect(state: dict[str, Any], request: dict[str, Any]) -> int:
    if state.get("hang"):
        Path(state["hang"]).touch()
        time.sleep(60)
    if state.get("down"):
        print("canopy-connect-github: cannot reach GitHub", file=sys.stderr)
        return 1
    prs = state.get("prs", {})
    whole = []
    asked = request.get("prs", [])
    if not asked:
        # The real reader refuses a request that names no PR.
        print('canopy-connect-github: stdin must name the PRs to read: {"prs": ["https://..."]}', file=sys.stderr)
        return 2
    for url in asked:
        if url not in prs or url in state.get("unread", []):
            print(f"canopy-connect-github: cannot read {url}", file=sys.stderr)
            continue
        number = int(url.rsplit("/", 1)[1])
        repository = "/".join(url.split("/")[3:5])
        pr = {
            "url": url,
            "repository": repository,
            "number": number,
            "head_sha": "abc1234",
            "base_ref": "main",
            "state": "open",
            "draft": False,
            "mergeable": "mergeable",
            "author": "me",
            **prs[url].get("pr", {}),
        }
        emit({"kind": "pr", **pr})
        for review in prs[url].get("reviews", []):
            emit({"kind": "review", "pr": url, **review})
        for check in prs[url].get("checks", []):
            emit({"kind": "check", "pr": url, "head_sha": pr["head_sha"], **check})
        whole.append(url)
    end: dict[str, object] = {"kind": "end", "prs": whole}
    if "repositories" in request:
        end["repositories"] = branches(state, request["repositories"])
    if "review_query" in request:
        end["review_query"] = state.get("review", [])
    emit(end)
    return 0 if len(whole) == len(asked) else 1


def branches(state: dict[str, Any], repositories: list[dict[str, str]]) -> list[str]:
    """Print each repository's branches, and return the names of those read whole."""
    whole = []
    for repo in repositories:
        if repo["name"] in state.get("unread", []):
            continue
        for name, sha in state.get("branches", {}).get(repo["name"], {}).items():
            emit({"kind": "branch", "repository": repo["name"], "name": name, "head_sha": sha})
        whole.append(repo["name"])
    return whole


def post(state: dict[str, Any], request: dict[str, Any]) -> int:
    login = state.get("login", "me")
    emit({"kind": "as", "login": login})
    outcome = state.get("post", "ok")
    if outcome == "refused":
        emit({"kind": "end", "submitted": False})
        return 1
    if "issue" in request:
        return post_issue(state, request, outcome)
    return post_pr(state, request, login, outcome)


def post_pr(state: dict[str, Any], request: dict[str, Any], login: str, outcome: str) -> int:
    url = request["pr"]
    if not react(state, request, login):
        emit({"kind": "end", "submitted": False})
        return 1
    replies = [r for r in request.get("replies", []) if "text" in r]
    comments = request.get("comments", [])
    if not replies and not comments and request.get("body") is None:
        emit({"kind": "end", "submitted": True})
        return 0
    pending_id = next_id(state)
    pending = f"PRR_fake_{pending_id}"
    emit({"kind": "pending", "review": pending, "id": pending_id})
    left = outcome == "pending_left"
    if refuses_a_comment(state, comments) or left:
        emit({"kind": "end", "submitted": False, **({"pending": pending} if left else {})})
        return 1
    if outcome == "unknown" and not state.get("posted"):
        return 1
    reviews = state.setdefault("prs", {}).setdefault(url, {}).setdefault("reviews", [])
    review_id = pending_id
    lines = add_comments(state, url, login, review_id, replies, comments)
    review_url = f"{url}#pullrequestreview-{review_id}"
    staged = request.get("submit") is False
    reviews.append(
        {
            "item": "review",
            "id": review_id,
            "author": login,
            "bot": False,
            "state": "pending" if staged else "commented",
            "time": "2026-10-18T12:00:00Z",
            "body": request.get("body") or "",
            "url": review_url,
            **({"commit": request["commit"]} if "commit" in request else {}),
        }
    )
    if outcome == "unknown":
        return 1
    for line in lines:
        emit(line)
    if not staged:
        emit({"kind": "review", "id": review_id, "url": review_url})
    emit({"kind": "end", "submitted": False, "staged": True} if staged else {"kind": "end", "submitted": True})
    return 0


def refuses_a_comment(state: dict[str, Any], comments: list[dict[str, Any]]) -> bool:
    """Whether GitHub refuses one of a review's comments, a line its diff does not show, saying which."""
    for index, c in enumerate(comments, 1):
        where = f"{c['path']}:{c['line']}"
        if where in state.get("refuse_lines", []):
            print(f"canopy-post-github: GitHub refused comment {index}, on {where}: not in the diff", file=sys.stderr)
            return True
    return False


def add_comments(
    state: dict[str, Any],
    url: str,
    login: str,
    review_id: int,
    replies: list[dict[str, Any]],
    comments: list[dict[str, Any]],
) -> list[dict[str, object]]:
    """Add each reply to its thread and each comment on a thread of its own, returning the lines to print."""
    lines = []
    reviews = state["prs"][url]["reviews"]
    for reply in replies:
        answered = next(r for r in reviews if r.get("item") == "comment" and r["id"] == reply["comment"])
        comment_id = next_id(state)
        reviews.append(
            {
                "item": "comment",
                "id": comment_id,
                "author": login,
                "bot": False,
                "time": "2026-10-18T12:00:00Z",
                "body": reply["text"],
                "url": f"{url}#discussion_r{comment_id}",
                "review": review_id,
                "thread": answered["thread"],
            }
        )
        discussion = f"{url}#discussion_r{comment_id}"
        lines.append({"kind": "comment", "comment": reply["comment"], "id": comment_id, "url": discussion})
    for index, new in enumerate(comments, 1):
        comment_id = next_id(state)
        discussion = f"{url}#discussion_r{comment_id}"
        where = {"id": f"PRRT_new_{comment_id}", "path": new["path"], "line": new["line"], "side": "right"}
        reviews.append(
            {
                "item": "comment",
                "id": comment_id,
                "author": login,
                "bot": False,
                "time": "2026-10-18T12:00:00Z",
                "body": new["text"],
                "url": discussion,
                "review": review_id,
                "thread": where,
            }
        )
        lines.append({"kind": "comment", "index": index, "id": comment_id, "url": discussion})
    return lines


def react(state: dict[str, Any], request: dict[str, Any], login: str) -> bool:
    """Add each reply's reaction, once, as GitHub keeps them, printing a line for each; False if GitHub refused."""
    url = request["pr"]
    for reply in request.get("replies", []):
        if "reaction" not in reply:
            continue
        if state.get("react") == "refused":
            print("canopy-post-github: GitHub refused the reaction", file=sys.stderr)
            return False
        added = {"pr": url, "comment": reply["comment"], "reaction": reply["reaction"], "by": login}
        if added not in state.setdefault("reactions", []):
            state["reactions"].append(added)
        found = state.get("prs", {}).get(url, {}).get("reviews", [])
        on = next((r for r in found if r.get("item") == "comment" and r["id"] == reply["comment"]), {})
        emit({"kind": "reaction", "comment": reply["comment"], "reaction": reply["reaction"], "url": on.get("url")})
    return True


def post_issue(state: dict[str, Any], request: dict[str, Any], outcome: str) -> int:
    if outcome == "unknown" and not state.get("posted"):
        return 1
    comment = {"url": request["issue"], "body": request["body"], "id": next_id(state)}
    state.setdefault("issues", []).append(comment)
    if outcome == "unknown":
        return 1
    emit({"kind": "comment", "id": comment["id"], "url": f"{request['issue']}#issuecomment-{comment['id']}"})
    emit({"kind": "end", "submitted": True})
    return 0


def next_id(state: dict[str, Any]) -> int:
    state["next_id"] = state.get("next_id", 9000) + 1
    return state["next_id"]


if __name__ == "__main__":
    sys.exit(main())
