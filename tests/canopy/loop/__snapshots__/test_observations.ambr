# name: test_stale_and_unobserved_subjects_name_what
  dict({
    'max_age_minutes': 30,
    'max_new_items': 10,
    'query': dict({
      'observed': 'stale',
      'read_at': '2026-10-20T10:00:00.000Z',
      'result': list([
        'PROJ-1',
      ]),
      'why': 'last read 2026-10-20T10:00:00.000Z',
    }),
    'tickets': list([
      dict({
        'key': 'PROJ-1',
        'observed': 'stale',
        'units': list([
          dict({
            'observed': 'stale',
            'repo': 'repo',
            'why': 'https://github.com/acme/repo/pull/7 never observed',
          }),
        ]),
        'why': 'PROJ-1 last observed 2026-10-20T10:00:00.000Z',
      }),
      dict({
        'key': 'PROJ-2',
        'observed': 'stale',
        'units': list([
        ]),
        'why': 'comments of PROJ-2 not observed since canopy first held it',
      }),
      dict({
        'blockers': list([
        ]),
        'candidate': True,
        'comments': list([
        ]),
        'derived': list([
        ]),
        'key': 'PROJ-3',
        'labels': list([
          dict({
            'added_at': None,
            'name': 'agent-ready-tester',
          }),
        ]),
        'observed': 'fresh',
        'observed_at': '2026-10-20T11:59:00.000Z',
        'state': 'open',
        'title': 'Retry flaky uploads',
        'units': list([
          dict({
            'observed': 'unobserved',
            'repo': 'repo',
            'why': "https://example.test/pr/1 is not a PR's URL, so it is not observed",
          }),
        ]),
      }),
    ]),
  })
# ---
