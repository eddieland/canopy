{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  // Imports sorted by path in groups, a blank line between: node's builtins, packages, the app's own (`@/`), then
  // relative paths, then stylesheets. Unused imports are removed by `npm run fmt` too (.oxlintrc.unused-imports.json).
  "sortImports": {
    "groups": ["builtin", "external", ["internal", "subpath"], ["parent", "sibling", "index"], "style", "unknown"]
  },
  // Tailwind classes in Tailwind's own order, read from our stylesheet so its utilities sort among the rest: in
  // className, and in the arguments of cn() and cva().
  "sortTailwindcss": { "stylesheet": "./src/index.css", "functions": ["cn", "cva"] },
  "ignorePatterns": ["src/routeTree.gen.ts", "src/api/schema.gen.ts", "package-lock.json", "**/*.md"]
}
