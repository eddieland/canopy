__vite_ssr_exportName__("default", () => { try { return __vite_ssr_export_default__ } catch {} });
const __vite_ssr_export_default__ = "# Your own config, never committed: a workspace's private file, .canopy/config.toml under its root, or the user file,\n# ~/.config/canopy/config.toml ($XDG_CONFIG_HOME/canopy/config.toml), which serves every workspace. Either overrides\n# canopy-workspace.toml key by key, and the private file overrides the user file. Keys marked private in DESIGN §12 may\n# be set only in these two. Every key, most at its default. `canopy init` writes only tracker.labels and the trust\n# lists, to the private file: set the rest only to change them.\n\n[tracker]\n# Your queue. A ticket is yours if it carries any of these labels. Never share a\n# label with another operator: both loops would work the same tickets.\nlabels = [\"agent-ready-yourname\"]\n# Optional: narrow the workspace's query to your labels to save the overseer reads. It applies in every workspace.\n# query = 'project = PROJ AND labels in (agent-ready-yourname) AND statusCategory != Done'\n# Optional: run the query at most this often, in minutes, to save its cost. A tick sooner than that after the last\n# one that ran it works the tickets canopy already knows, so a newly labeled ticket can wait this long to be found.\n# 0 runs it every tick (DESIGN §7, Spacing the query).\n# query_every_minutes = 0\n# Optional: your own needs-human label, if it differs from the workspace's.\n# needs_human_label = \"needs-human\"\n# For tickets you work privately with `canopy start` (DESIGN §22): the tracker's MCP server, as your OpenCode config\n# names it, and the only tools of it a private worker may call. Every other tool of that server is denied. Unset, the\n# defaults for \"jira\" (Atlassian's server, named \"atlassian\") and \"github\" (GitHub's, named \"github\") apply. With\n# Atlassian's server, use its `?tools=all` URL: without it, most Jira tools hide behind `execute*` tools, which are\n# denied.\n# mcp_server = \"atlassian\"\n# read_tools = [\"getJiraIssue\", \"searchJiraIssuesUsingJql\", \"listJiraIssueComments\"]\n\n[capacity]\nmax_workers = 2\n# Chore runs at once, apart from max_workers; 0 turns every chore off (DESIGN §19).\nmax_chores = 1\n# Runs of your one-off tasks (`canopy task submit`) at once, within max_workers; 0 starts none (DESIGN §36).\n# max_tasks = 1\n# Slots in each repository's pool. `canopy workspace sync` makes and removes slots to match, and no run grows a pool\n# past it. Unset leaves the pools to treehouse's own max_trees (DESIGN §18).\n# slots_per_repo = 2\n# [capacity.repo_slots]   # per repository, by its name in the map; wins over slots_per_repo\n# api = 4\n\n[runtime]\n# {definitions_dir} is the directory canopy's agent definitions and skills are in (D040). Every template that runs one\n# of canopy's agents must contain it. OpenCode reads it as OPENCODE_CONFIG_DIR, after the repository's own config.\n# {title}, optional, is the session's title: `<KEY> <kind>: <the ticket's title>` for a worker (DESIGN §13).\noverseer_cmd = '''env OPENCODE_CONFIG_DIR={definitions_dir} opencode run --agent canopy-overseer --format json\n    --title={title} {prompt}'''\n# The overseer's temperature: -1 sends none, for when the overseer runs on a model that refuses one, such as OpenAI's\n# reasoning models. review_temperature, below, does the same for the reviewer's.\n# overseer_temperature = 0.1\nworker_cmd   = '''env OPENCODE_CONFIG_DIR={definitions_dir} opencode run --agent canopy-worker --format json\n    --title={title} {prompt}'''\n# A ticket you started with `canopy start` runs `private_worker_cmd`: worker_cmd's default with\n# `--agent canopy-worker-private`, an agent that cannot write to the tracker (DESIGN §22).\n# Chores run this unless they set their own `cmd` (DESIGN §19).\nchore_cmd    = '''env OPENCODE_CONFIG_DIR={definitions_dir} opencode run --agent canopy-chore --format json\n    --title={title} {prompt}'''\n# The planner writes a ticket's plan before its first implement, reading only (DESIGN §25).\nplan_cmd     = '''env OPENCODE_CONFIG_DIR={definitions_dir} opencode run --agent canopy-planner --format json\n    --title={title} {prompt}'''\n# The reviewer's temperature (DESIGN §21): -1, the default, sends none, since the reviewer often runs on a model that\n# refuses one, such as OpenAI's reasoning models. Set a low one when it runs on a model that takes it: each new\n# commit is reviewed again, and a cooler reviewer's findings wander less from one commit to the next.\n# review_temperature = 0.1\noverseer_timeout_minutes = 15\nworker_timeout_minutes = 45\n# Optional: a skill of yours that workers open PRs with, and in no other way, instead of the GitHub MCP (DESIGN §8).\n# Put it where your runtime reads skills (a $HOME skill must be a single SKILL.md), and any program it runs on the PATH\n# of the shell that runs canopy. If a worker cannot find it, the run fails rather than using the MCP.\n# pr_skill = \"acme-open-pr\"\n# Optional: run in each slot once the run's branch is checked out, before the worker, with CANOPY_REPO naming the\n# repository; a failure or timeout ends the run crashed (DESIGN §9). It runs the branch's code on this machine. No\n# shell runs it: write `sh -c '...'` for one. Plans and reviews run none.\n# setup_cmd = \"sh -c 'pnpm install --frozen-lockfile'\"\n# setup_timeout_minutes = 30\n# Optional: words before and after every command a worker run starts (worker_cmd, private_worker_cmd, and plan_cmd),\n# with {definitions_dir} and {title} but no {prompt}. One place for a sandbox wrapper (docs/SANDBOX.md), or an option\n# all three take, but a model: [runtime.models] chooses that.\n# worker_cmd_prefix = \"canopy-sandbox worker --read {definitions_dir} --\"\n# worker_cmd_suffix = \"--log-level INFO\"\n# Optional: commands an agent may run beyond its own bash rules, such as a tracker's CLI for the overseer while its MCP\n# server is down. An allow in your runtime's own config cannot beat canopy's deny; these can (DESIGN §13). The\n# overseer, planner, worker, and worker-private take them; the overseer, which acts through canopy's tools and has no\n# shell otherwise, and the planner run only these, and a worker every command but those its rules deny, so for one an\n# allow undoes a deny, such as the private worker's of a tracker's CLI (TRUST_MODEL T6). canopy refuses a shell, an\n# interpreter, a wrapper such as env or xargs, git, gh, curl, and its own tools, and you answer for what an allowed\n# command can do (TRUST_MODEL T1). Tell the overseer when to use them in paths.overseer_instructions, and the planner\n# and workers in paths.worker_instructions. `canopy agents` lists them.\n# [runtime.allow_bash]\n# overseer = [\"jira issue list *\", \"jira issue view *\"]\n# planner = [\"jira issue view *\"]\n# worker-private = [\"jira issue view *\"]\n# Optional: each agent's model, `provider/model` as `opencode models` lists it, or `provider/model@variant` to run it at\n# one of the variants `opencode models --verbose` lists for it, such as a reasoning effort (DESIGN §13). canopy writes\n# it into the agent's definition and records it on each worker run; an agent not named runs on OpenCode's default. A\n# template, prefix, or suffix that passes --model, -m, or --variant is refused, since it would override this unseen.\n# Before a worker run starts, its model and variant are looked up in `opencode models`: one not listed, or a list that\n# cannot be read, refuses the run with an attention item, never running it on another model. Private, as every\n# runtime key is.\n# One ticket's worker, planner, or reviewer can take another model, to canary it: `canopy model KEY MODEL`, or the\n# ticket's page.\n# [runtime.models]\n# worker = \"provider/model\"     # both workers, and your tasks' runs\n# planner = \"provider/model\"\n# reviewer = \"provider/other-model@high\"\n# overseer = \"provider/model\"\n# chore = \"provider/model\"      # every chore without a model of its own\n\n[loop]\n# `canopy loop` waits this long after each tick ends. Every tick runs the overseer, so this sets its spend.\ninterval_minutes = 15\n# After each tick that found nothing new, the wait doubles, up to this. It ends sooner when a run ends, the CI\n# cooldown or a chore's due time comes, or you reply. Set it to interval_minutes to wait the same after every tick.\n# idle_max_minutes = 120\n# No tick starts sooner than this after the last one ended, whatever wakes the loop, unless you press t at its terminal.\n# min_gap_minutes = 1\n# No tick runs the overseer, so none starts work, while the disk holding .canopy/ or the workspace has less free than\n# this, in MiB; you are told through the attention list. 0 turns the check off.\n# min_free_disk_mib = 2048\n\n[trust]\n# Tracker account ids whose ticket comments may resume your blocked work. Use the\n# tracker's stable id, not a display name: Jira accountId, GitHub login.\nauthorized_repliers = [\"replace-with-your-account-id\"]\n# GitHub logins whose PR review comments a worker may address without asking you, and \"canopy:review\" for canopy's own\n# reviewer ([review]). Anyone else's comments, a review bot's included, wait on the attention list as untrusted_review\n# until you answer with `canopy reply KEY '...'` or the web UI: what to do about them, or leave them. Empty: all wait.\ntrusted_reviewers = [\"replace-with-your-github-login\"]\n# Every comment a worker posts starts with the prefix and ends with the suffix, each if set; set at least one.\n# Workers post as you, so this is how canopy tells their comments from yours: a comment that carries every mark\n# set is never feedback or an instruction.\ncomment_prefix = \"CANOPY:\"\ncomment_suffix = \"\"\n# The Co-authored-by trailer a worker adds to its commits when the agent runtime adds none of its own. Name an agent\n# here, such as your team's bot address, never a person: it is how a reader tells the work is an agent's. Left as the\n# default, the name credits the model [runtime.models] chooses for the worker, as \"provider/model (canopy worker)\",\n# and a worker following an approved plan adds a second trailer for its planner's, \"provider/model (canopy planner)\";\n# a name you set is used as you set it, alone. Set commit_trailer = false to add none, keeping only the runtime's own\n# attribution, if it adds any.\n# commit_trailer = true\n# commit_trailer_name = \"canopy worker\"\n# commit_trailer_email = \"noreply@canopy.invalid\"\n# Set if your repositories refuse merge commits: workers then rebase onto a base branch instead of merging it in, and\n# push the result with --force-with-lease to their own branch, never any other force (TRUST_MODEL T1).\n# rebase = false\n# How replies to review comments, and every other comment a worker would post, reach GitHub (DESIGN §29): \"post\" has\n# workers post them, marked; \"approve\" has them draft each one for you to read, edit, and send as your own words.\n# review_replies = \"post\"\n\n[paths]\nprompt_overrides = \"~/.config/canopy/prompts\"\n# Optional: your own .worktreeinclude, passed to every `treehouse get`. It replaces the committed one: copy in its lines\n# to keep them. It selects gitignored files in the primary clone to copy into each slot (DESIGN §9).\n# worktree_include = \"~/.config/canopy/worktreeinclude\"\n# Optional: a few lines every worker should follow, such as \"commit review fixes with `git commit --fixup`\". They go\n# into every worker's prompt, at most 4 KiB, so you need not copy a prompt to add them (DESIGN §12).\n# worker_instructions = \"~/.config/canopy/worker-instructions.md\"\n# Optional: the same for the overseer, such as \"dispatch tickets labeled urgent before the rest\". They go at the end of\n# its prompt, at most 4 KiB, and never reach a worker (DESIGN §12).\n# overseer_instructions = \"~/.config/canopy/overseer-instructions.md\"\n# Optional: the same for every reviewer, such as \"treat a missing migration test as a finding\", and for every chore\n# run, after the chore's own prompt, such as \"name a CI job by its workflow file\". Each at most 4 KiB (DESIGN §12).\n# reviewer_instructions = \"~/.config/canopy/reviewer-instructions.md\"\n# chore_instructions = \"~/.config/canopy/chore-instructions.md\"\n# Optional: your own personas, each `<name>.md`, at most 4 KiB. One named as canopy's shadows it; `canopy personas`\n# lists them all (DESIGN §31).\n# personas = \"~/.config/canopy/personas\"\n# Optional: a clone of a private repository of yours. Each live tick copies every plan of the workspace into\n# <clone>/<workspace>/, with its status and approval, commits, and pushes to the clone's upstream (DESIGN §25). Plans\n# hold what planners read of your tickets: keep the repository private. `canopy archive DIR` does the copy by hand.\n# plan_archive = \"~/src/plans\"\n# Set false to archive into the clone's top level rather than <clone>/<workspace>/, for a repository that holds this\n# workspace's plans alone. Only what canopy wrote there is committed: each ticket's directory and its own README.md.\n# plan_archive_workspace_dir = true\n# Each plan goes with the prompt its planner was given, which carries your messages and standing instructions. Set\n# false to archive plans alone; `canopy archive DIR` copies prompts either way.\n# plan_archive_prompts = true\n# Set true to archive each planned ticket's conversation beside its plans too: workers' reports and questions, your\n# replies, and mirrored tracker comments, a private ticket's included. `canopy archive DIR --conversations` copies them.\n# plan_archive_conversations = false\n\n# Optional: the persona each agent writes in, by name: its voice and what it weighs most, never what it may do. A run\n# whose persona has no file is refused, never run in canopy's voice instead (DESIGN §31).\n# [personas]\n# worker = \"canopy\"                             # every implement and resume; or \"minimalist\", \"explainer\"\n# planner = \"canopy\"                            # every plan; or \"skeptic\"\n# reviewer = \"canopy\"                           # every review; or \"skeptic\", \"eddie\"\n\n[notify]\n# Optional. Receives the attention-list diff on stdin after each tick, as text: the sink named `default`.\ncmd = \"\"\n\n# Optional notification sinks (DESIGN §20): each a command that reads one message on stdin, at most 5.\n# [notify.sinks.desktop]\n# cmd = \"canopy-notify-desktop\"\n# events = [\"attention\", \"loop\", \"runs\"]        # attention | loop | runs | chores | reviews | tasks\n#\n# [notify.sinks.slack]\n# cmd = \"canopy-notify-slack\"                   # reads its webhook from ~/.config/canopy/slack-webhook, mode 600\n# cmd = \"canopy-notify-slack --channel C0123ABCD\"  # or a bot token, from ~/.config/canopy/slack-token, mode 600\n# events = [\"attention\", \"loop\", \"runs\"]\n# digest_every_minutes = 240                    # a summary every 4 hours, what its runs cost by kind among it\n# digest_min_usd = 5                            # sent only once the runs since the last one cost $5 or more\n# batch_minutes = 15                            # at most one message per 15 minutes, unless something needs you\n\n# Optional: the web UI `canopy loop` serves (DESIGN §22). While it serves one, a json sink's messages link to its pages.\n# [serve]\n# port = 8765\n# url = \"http://localhost:9000/\"                # where those links open it, such as an SSH forward's port;\n#                                               # it replaces the whole address, so add base_path if you set one\n\n# Optional: the programs canopy reads GitHub with and posts your approved replies through (DESIGN §29). Unset, the\n# vcs source is canopy's own, which use the token `gh` holds for each PR's and repository's host. A tracker source\n# with a post_cmd lets canopy post a ticket's drafts too, as for GitHub Issues.\n# [connect.sources.github]\n# kind = \"vcs\"\n# cmd = \"canopy-connect-github\"\n# post_cmd = \"canopy-post-github\"\n# timeout_minutes = 2\n#\n# [connect.sources.issues]\n# kind = \"tracker\"\n# post_cmd = \"canopy-post-github\"\n#\n# Or, at most one tracker source, canopy's Jira Cloud reader (DESIGN §30). It reads your email and an API token, one\n# line EMAIL:API_TOKEN, from ~/.config/canopy/jira-credentials, mode 600, and sends them to this site alone.\n# [connect.sources.jira]\n# kind = \"tracker\"\n# cmd = \"canopy-connect-jira --site acme.atlassian.net\"\n\n# Optional: recurring chores the overseer runs when due (DESIGN §19). The prompt is your own file. A chore that runs\n# your own tools sets `cmd` to an agent of yours, defined in ~/.config/opencode/agent/, that allows exactly those tools.\n# examples/chores/build-health.md is a prompt to start from: it needs only the shipped agent and a GitHub MCP server.\n# `canopy chore install build-health` copies it into .canopy/ and writes this table to the private file; name your\n# repositories in the copy, and run `canopy chore try build-health` until its findings are the ones you want.\n# [chores.build-health]\n# prompt = \"~/.config/canopy/chores/build-health.md\"\n# every_minutes = 120\n# days = [\"mon\", \"tue\", \"wed\", \"thu\", \"fri\"]   # when a run may start, checked in code; default every day, all day\n# hours = \"08:00-18:00\"\n# timezone = \"America/New_York\"                # default this machine's local time\n# when = \"Skip it when the last run found nothing.\"\n# timeout_minutes = 20\n# workspaces = [\"acme\"]   # default: every workspace\n# model = \"provider/model@low\"   # default runtime.models.chore; only for a chore that runs canopy-chore\n\n# Optional: adversarial reviews of PRs (DESIGN §21). A fresh reviewer reads each new commit and reports to canopy only:\n# it posts nothing on the PR and never approves (D114). Read reviews with `canopy review show`. Point review_cmd at a\n# different model than worker_cmd, so the reviewer does not share the author's blind spots.\n# [review]\n# agent_prs = true                                            # the loop's own PRs, before a human is asked\n# query = 'repo:acme/api is:pr is:open author:@me -is:draft'  # your own PRs, reviewed for you alone\n# low_impact = \"Only docs, comments, or tests change.\"\n\n# Optional: an artifact store workers publish pages to for people to comment on (DESIGN §38), Louvre or canopy's local\n# one, `canopy-artifacts serve`, each an MCP server your runtime config names. Every agent's definition denies the\n# server but those publish_roles names; \"worker\" is the one role that may publish, and only for public tickets.\n# [artifacts]\n# mcp_server = \"louvre\"\n# namespace = \"canopy/operator\"\n# authorized_authors = [\"u_ana\", \"u_raj\"]     # whose comments steer a worker, once comments come back (M62)\n# publish_roles = [\"worker\"]\n#\n# And a source that reads the store's comments into canopy's journal each tick, the local store's feed here; for now\n# nothing acts on what it reads (DESIGN §30).\n# [connect.sources.artifacts]\n# kind = \"artifacts\"\n# cmd = \"canopy-artifacts feed --store /path/to/your/store --namespace canopy/operator\"\n\n# Optional: how long canopy keeps its own history (DESIGN §26); 0 keeps a kind forever. `canopy gc --dry-run` shows\n# what each kind holds and what a pass would remove. A live tick removes the files and the journal's rows once a day,\n# and rotates canopy.log; `canopy gc --vacuum`, between ticks, gives the journal's free pages back to the disk, and\n# `canopy gc --git` packs the primary clones' loose objects.\n# [retention]\n# run_files_days = 30    # a run's, chore run's, or review's log, prompt, and diff, once it ended this long ago\n# tick_files_days = 7    # a tick's log and prompt; a tick not `ok` keeps them for run_files_days\n# journal_days = 90      # harness attention rows, connector runs, derivations, past the attention list's window\n# log_max_mib = 50       # canopy.log is rotated past this\n# log_keep = 3           # and this many rotated files are kept\n# memory_days = 30       # the text of a note or proposal no longer in force; a lesson's is never removed\n"
