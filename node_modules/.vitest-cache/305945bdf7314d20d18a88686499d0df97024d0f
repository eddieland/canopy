const __vite_ssr_export_default__ = "# canopy-workspace.toml - the map of a workspace: the repositories that share one queue (DESIGN §18), one or more.\n# Written by `canopy init`. It is canopy's only shared config; no code repository holds any (D016). Shared keys only:\n# your own settings live in .canopy/config.toml, this workspace's private file, or in ~/.config/canopy/config.toml for\n# every workspace. Commit it if the workspace is shared.\n#\n# `canopy workspace sync` makes the workspace match this map: it clones what is listed and removes a clone that is no\n# longer listed, when nothing in it would be lost. Pool sizes are personal: capacity.slots_per_repo in your user file.\n#\n# Layout under the workspace root: repos/<name> (clones; `canopy workspace sync`), .treehouse/ (the pools), .canopy/\n# (journal, logs, attention.md; readable only by you), and MAP.md (prose about the repositories, for the overseer).\n\n[workspace]\nname = \"acme\"\n\n# One table per repository. The name is its directory under repos/ and what the overseer passes as --repo.\n[repos.api]\nurl = \"https://github.com/acme/api.git\"\nsummary = \"Public REST API. Owns the order schema and the generated OpenAPI spec.\"\n# Optional: a branch's page on the repository's host, with {branch} where its name goes, for the web UI's links. A\n# GitHub url gives one by default (.../tree/{branch}); set this for another host, or to \"\" for no links.\n# branch_url = \"https://gitlab.com/acme/api/-/tree/{branch}\"\n# Optional: the checks that are not CI, ones that stay pending until a person acts, such as a deploy approval. canopy\n# does not wait on them, count them red, or need them to pass. Every other check is CI.\n# human_checks = [\"deploy/approval\"]\n\n[repos.web]\nurl = \"https://github.com/acme/web.git\"\nsummary = \"Customer web app. Consumes the api's generated client from a release.\"\n\n[tracker]\nprovider = \"jira\"\n# Added by a worker that needs an answer, removed when it resumes. Any label your tracker accepts; it must\n# already exist, since canopy does not create labels.\nneeds_human_label = \"needs-human\"\nquery = 'project = ACME AND statusCategory != Done ORDER BY priority DESC, created ASC'\n# Optional: a ticket's page, with {key} where its key goes. The web UI links each ticket there.\n# ticket_url = \"https://acme.atlassian.net/browse/{key}\"\n\n[trust]\nbranch_prefix = \"agent/\"\n"
