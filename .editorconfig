# EditorConfig: https://editorconfig.org
# Line length is 120 for every file type. See "Formatting" in AGENTS.md.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{toml,yml,yaml,json}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.sql]
indent_size = 2
